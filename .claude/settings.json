{
  "permissions": {
    "allow": [
      "Bash(terraform init)",
      "Bash(terraform plan*)",
      "Bash(terraform validate*)",
      "Read",
      "Grep",
      "Glob"
    ],
    "deny": ["Bash(terraform destroy*)", "Bash(rm -rf*)"]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/user-prompt-guard.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-tool-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-tool-logger.sh"
          }
        ]
      }
    ]
  }
}